# GEMINI_API_KEY: heredado de la plantilla original de AI Studio.
# No se usa en src/ (verificado por grep) — no tocar salvo pedido explícito.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: usado para armar back_urls y notification_url de Mercado Pago.
# En Vercel se puede dejar vacío: el backend lo infiere de req.headers.host.
APP_URL="MY_APP_URL"

# --- Mercado Pago (Fase 3 del roadmap — Reservas + Operación) ---
# Access Token del servidor. SOLO credenciales de TEST hasta que Rose Face
# firme el contrato. NUNCA commitear el valor real — vive solo en Vercel
# Environment Variables y se usa exclusivamente en /api/*.
MP_ACCESS_TOKEN=

# Public Key — esta sí puede exponerse en el frontend si hace falta más adelante.
MP_PUBLIC_KEY=

# Usado para validar que la notificación del webhook viene realmente de Mercado Pago.
MP_WEBHOOK_SECRET=
